# OmniGesture AI - Environment Variables Example
# Copy this file to .env or configure in your deployment dashboard (e.g., Vercel, Render)

# Frontend: URL of your deployed or local FastAPI backend
# Leave empty for local development (defaults to local Vite proxy)
# In production on Vercel, set this to your cloud backend (e.g., https://omnigesture-backend.onrender.com)
VITE_API_URL=

# Backend Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
